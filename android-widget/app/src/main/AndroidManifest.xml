<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 必要な権限は INTERNET のみ（アニメーションも追加の権限なし） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hatoru">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".HatoruWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hatoru_widget_info" />
        </receiver>

        <!-- ウィジェットのコマ画像をランチャーに読ませる読み取り専用プロバイダー（frames/ の画像だけを公開） -->
        <provider
            android:name=".FrameProvider"
            android:authorities="${applicationId}.frames"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
