<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews で使えるビューだけで構成（FrameLayout / LinearLayout / ImageView / TextView / ViewFlipper） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/room_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hatoru_room"
        android:contentDescription="@string/room_image_description"
        android:scaleType="centerCrop" />

    <!-- コマ送りアニメーション。24コマを flipInterval ごとに切り替え、前後のコマをクロスフェードでつなぐ
         （切り替えはランチャー側で行われる）。コマが無いときは GONE にして、下の静止画を見せる -->
    <ViewFlipper
        android:id="@+id/room_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="417"
        android:inAnimation="@anim/frame_fade_in"
        android:outAnimation="@anim/frame_fade_out"
        android:visibility="gone">

        <ImageView android:id="@+id/frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_4" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_5" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_6" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_7" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_8" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_9" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_10" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_11" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_12" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_13" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_14" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_15" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_16" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_17" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_18" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_19" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_20" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_21" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_22" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
        <ImageView android:id="@+id/frame_23" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/room_image_description" android:scaleType="centerCrop" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/caption_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/state_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/task_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:text="@string/widget_tap_to_load"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/updated_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
